# ============================================================
# Expense Tracker — Required Environment Variables
# Copy this file to backend/.env and fill in actual values.
# NEVER commit the .env file to version control.
# ============================================================

# --- MongoDB Atlas ---
# Full SRV connection string from MongoDB Atlas dashboard.
# Must start with mongodb+srv://
MONGODB_URI=

# --- JWT ---
# Long random secret used to sign/verify JSON Web Tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# --- OpenRouter AI (for expense categorisation and insights) ---
# Get a key at https://openrouter.ai/
# Leave empty to use local keyword-based fallback (no AI required).
OPENROUTER_API_KEY=
# Optional — defaults to openai/gpt-4o-mini
OPENROUTER_MODEL=
# Optional — sent as HTTP-Referer header to OpenRouter
OPENROUTER_SITE_URL=
# Optional — sent as X-Title header to OpenRouter
OPENROUTER_APP_NAME=

# --- Cashfree Payments (Premium Membership) ---
# Create a Cashfree account at https://merchant.cashfree.com/
# Use SANDBOX credentials for development and testing.
# CASHFREE_ENV must be either:  sandbox  or  production
CASHFREE_ENV=sandbox
# App ID from Cashfree dashboard → Developers → API Keys
CASHFREE_APP_ID=
# Secret Key from Cashfree dashboard → Developers → API Keys
CASHFREE_SECRET_KEY=
# URL Cashfree redirects to after payment (must be a full URL including http/https)
# For local dev use something like: http://localhost:5000/expenses.html
# For production use your Vercel URL: https://expense-tracker-app-mu-neon.vercel.app/expenses.html
CASHFREE_RETURN_URL=
# Only enable this for local development without Cashfree credentials.
CASHFREE_SIMULATION=false

# Public URL used for payment redirects and OpenRouter metadata.
# Do not set this to localhost in production.
PUBLIC_APP_URL=https://expense-tracker-app-mu-neon.vercel.app

# --- Server (optional) ---
PORT=5000
HOST=0.0.0.0
# Comma-separated extra origins to allow in CORS (optional)
CORS_ORIGINS=

# ============================================================
# VERCEL ENVIRONMENT VARIABLES
# Add ALL of the above to your Vercel project settings at:
# https://vercel.com/your-team/expense-tracker-app-mu-neon/settings/environment-variables
#
# Required on Vercel:
#   MONGODB_URI
#   JWT_SECRET
#
# Optional on Vercel (enables AI):
#   OPENROUTER_API_KEY
#   OPENROUTER_MODEL
#   OPENROUTER_SITE_URL
#   OPENROUTER_APP_NAME
#
# Optional on Vercel (enables real Cashfree payments):
#   CASHFREE_APP_ID
#   CASHFREE_SECRET_KEY
#   CASHFREE_ENV          (sandbox or production)
#   CASHFREE_RETURN_URL   (https://expense-tracker-app-mu-neon.vercel.app/expenses.html)
#   CASHFREE_SIMULATION   (false in production)
#   PUBLIC_APP_URL         (https://expense-tracker-app-mu-neon.vercel.app)
# ============================================================
